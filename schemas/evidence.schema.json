{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location3.local/schemas/evidence.schema.json",
  "title": "EvidenceBundle",
  "type": "object",
  "required": ["schema_version", "candidates", "observations"],
  "properties": {
    "schema_version": {"const": "1"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "location"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "place_kind": {
            "enum": ["city", "town", "suburb", "village", "neighbourhood"]
          },
          "location": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": {"type": "number", "minimum": -90, "maximum": 90},
              "longitude": {"type": "number", "minimum": -180, "maximum": 180}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "rail_journeys": {
      "type": "array",
      "items": {"$ref": "rail-research.schema.json#/$defs/journey"}
    },
    "housing_research": {
      "$ref": "housing-research.schema.json"
    },
    "street_care_research": {
      "$ref": "street-care-research.schema.json"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": ["id", "candidate_id", "metric", "value", "unit", "geographic_scope", "source", "source_url", "retrieved_at", "source_date", "transformation", "licence", "confidence", "confidence_notes"],
      "properties": {
        "id": {"type": "string"},
        "candidate_id": {"type": "string"},
        "metric": {"type": "string"},
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "geographic_scope": {"type": "string"},
        "source": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_date": {"type": "string", "format": "date"},
        "transformation": {"type": "string"},
        "licence": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
