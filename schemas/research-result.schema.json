{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location3.local/schemas/research-result.schema.json",
  "title": "ResearchResult",
  "type": "object",
  "required": ["schema_version", "scoring_version", "run_id", "generated_at", "unknown_data_policy", "candidates"],
  "properties": {
    "schema_version": {"const": "1"},
    "scoring_version": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "unknown_data_policy": {"const": "warn"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "location", "rank", "overall_score", "confidence", "hard_constraints", "categories", "informational_metrics", "missing_metrics", "warnings"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "location": {"type": "object"},
          "rank": {"type": "integer", "minimum": 1},
          "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
          "confidence": {"type": "number", "minimum": 0, "maximum": 100},
          "hard_constraints": {"type": "object"},
          "categories": {"type": "array"},
          "informational_metrics": {"type": "array"},
          "rail_summary": {
            "type": "object",
            "required": ["primary_journey_id", "fastest_total_minutes", "journeys"],
            "properties": {
              "primary_journey_id": {"type": "string", "minLength": 1},
              "fastest_total_minutes": {"type": "number", "minimum": 0},
              "journeys": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "rail-research.schema.json#/$defs/journey"}
              }
            },
            "additionalProperties": false
          },
          "housing_summary": {
            "type": "object",
            "required": ["mode", "budget_gbp", "budget_period", "property_type", "bedrooms", "typical_cost_gbp", "budget_ratio", "inventory_status", "market"],
            "properties": {
              "mode": {"enum": ["buy", "rent"]},
              "budget_gbp": {"type": "number", "exclusiveMinimum": 0},
              "budget_period": {"enum": ["purchase", "month"]},
              "property_type": {"type": "string", "minLength": 1},
              "bedrooms": {"type": ["integer", "null"], "minimum": 0},
              "typical_cost_gbp": {"type": "number", "exclusiveMinimum": 0},
              "budget_ratio": {"type": "number", "exclusiveMinimum": 0},
              "inventory_status": {"const": "not_checked"},
              "market": {"$ref": "housing-research.schema.json#/$defs/market"}
            },
            "additionalProperties": false
          },
          "street_care_summary": {
            "type": "object",
            "required": ["assessment_date", "score", "basis", "confidence", "audit_age_days", "components", "place"],
            "properties": {
              "assessment_date": {"type": "string", "format": "date"},
              "score": {"type": "number", "minimum": 0, "maximum": 100},
              "basis": {"enum": ["proxy", "recent_visit_audit"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "audit_age_days": {"type": ["integer", "null"], "minimum": 0},
              "components": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["key", "raw_value", "unit", "normalized_score", "weight", "included"],
                  "properties": {
                    "key": {"type": "string", "minLength": 1},
                    "raw_value": {"type": ["number", "null"]},
                    "unit": {"type": "string", "minLength": 1},
                    "normalized_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                    "weight": {"type": "number", "minimum": 0, "maximum": 1},
                    "included": {"type": "boolean"}
                  },
                  "additionalProperties": false
                }
              },
              "place": {"$ref": "street-care-research.schema.json#/$defs/place"}
            },
            "additionalProperties": false
          },
          "missing_metrics": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
