{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location3.local/schemas/research-manifest.schema.json",
  "title": "ResearchManifest",
  "type": "object",
  "required": ["schema_version", "run_id", "generated_at", "scoring_version", "tool_versions", "geographic_coverage", "request_ledger", "cache_used", "sources", "licences", "warnings", "checksums"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scoring_version": {"type": "string"},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "geographic_coverage": {"$ref": "research-profile.schema.json#/$defs/route_boundary"},
    "request_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "request_id", "endpoint", "requested_at", "cache", "status"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "request_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "endpoint": {"type": "string", "format": "uri"},
          "requested_at": {"type": "string", "format": "date-time"},
          "cache": {"enum": ["hit", "miss"]},
          "status": {"type": "integer", "minimum": 0, "maximum": 599},
          "cache_expires_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "cache_used": {"type": "boolean"},
    "sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "licences": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "checksums": {
      "type": "object",
      "required": ["profile.json", "evidence.json", "results.json"],
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  },
  "additionalProperties": false
}
