{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location3.local/schemas/photo-research.schema.json",
  "title": "PhotoResearch",
  "description": "One freely licensed photo per place, fetched on the user's machine with its author and licence kept beside it.",
  "type": "object",
  "required": ["schema_version", "provider", "retrieved_at", "photos"],
  "properties": {
    "schema_version": {"const": "1"},
    "provider": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "photos": {
      "type": "array",
      "items": {"$ref": "#/$defs/photo"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "photo": {
      "type": "object",
      "required": ["candidate_id", "file", "width", "height", "title", "author", "licence", "licence_url", "source_url", "page_title"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "pattern": "^photos/[a-z0-9][a-z0-9-]{0,79}\\.(jpg|png)$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "licence": {"type": "string", "minLength": 1},
        "licence_url": {"type": ["string", "null"], "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "page_title": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
